#!/bin/bash

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$0")" && pwd -P)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
PROFILE=workstation
BACKUP_EXISTING=0
FORCE_LINKS=0
BACKUP_STAMP="$(date +%Y%m%d-%H%M%S)"

usage() {
    cat <<'EOF'
usage: ./install [--backup|--force] [server]

With no argument, install the Zsh and Neovim workstation profile.
Use "server" to install the Bash, inputrc, and Vim server profile.

Options:
  --backup  move existing targets aside before installing
  --force   replace existing non-shell install paths without backup
EOF
}

for arg; do
    case $arg in
        server) PROFILE=server ;;
        --backup) BACKUP_EXISTING=1 ;;
        --force) FORCE_LINKS=1 ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
done
[ "$((BACKUP_EXISTING + FORCE_LINKS))" -le 1 ] || { usage >&2; exit 2; }

backup_target() {
    local target=$1 backup candidate suffix
    backup="$target.backup-$BACKUP_STAMP"
    candidate=$backup
    suffix=1
    while [ -e "$candidate" ] || [ -L "$candidate" ]; do
        candidate="$backup.$suffix"
        suffix=$((suffix + 1))
    done
    mv "$target" "$candidate"
    printf 'back  %s -> %s\n' "$target" "$candidate"
}

link_file() {
    local source=$1 target=$2
    if [ ! -e "$source" ]; then
        printf 'error source does not exist: %s\n' "$source" >&2
        return 1
    fi
    mkdir -p "$(dirname "$target")"

    if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
        printf 'ok    %s\n' "$target"
        return
    fi
    if [ -e "$target" ] || [ -L "$target" ]; then
        if [ "$BACKUP_EXISTING" -eq 1 ]; then
            backup_target "$target"
        elif [ "$FORCE_LINKS" -eq 1 ]; then
            rm -rf -- "$target"
            printf 'rm    %s\n' "$target"
        else
            printf 'error %s already exists\n' "$target" >&2
            return 1
        fi
    fi

    ln -s "$source" "$target"
    printf 'link  %s -> %s\n' "$target" "$source"
}

source_shell() {
    local target=$1 source=$2 line
    if [ ! -r "$source" ]; then
        printf 'error source is not readable: %s\n' "$source" >&2
        return 1
    fi
    line="[ -r \"$source\" ] && . \"$source\""
    if [ -e "$target" ] || [ -L "$target" ]; then
        if grep -Fqx "$line" "$target"; then
            printf 'ok    %s\n' "$target"
            return
        fi
        if [ "$BACKUP_EXISTING" -eq 1 ]; then
            backup_target "$target"
        fi
    fi
    touch "$target"
    printf '\n# Personal dotfiles\n%s\n' "$line" >> "$target"
    printf 'edit  %s\n' "$target"
}

install_common() {
    link_file "$DOTFILES_DIR/config/bat/config" "$CONFIG_HOME/bat/config"
    link_file "$DOTFILES_DIR/config/bat/themes" "$CONFIG_HOME/bat/themes"
    link_file "$DOTFILES_DIR/config/ssh/config" "$CONFIG_HOME/dotfiles/ssh/config"
    link_file "$DOTFILES_DIR/config/git/config" "$CONFIG_HOME/git/config"
    link_file "$DOTFILES_DIR/config/git/ignore" "$CONFIG_HOME/git/ignore"
    link_file "$DOTFILES_DIR/config/lsd/colors.yml" "$CONFIG_HOME/lsd/colors.yml"
    link_file "$DOTFILES_DIR/config/lsd/config.yml" "$CONFIG_HOME/lsd/config.yml"
    link_file "$DOTFILES_DIR/config/screen" "$HOME/.screenrc"
    link_file "$DOTFILES_DIR/config/tmux" "$HOME/.tmux.conf"

    local script
    for script in "$DOTFILES_DIR"/bin/*; do
        [ -f "$script" ] || continue
        link_file "$script" "$HOME/bin/$(basename "$script")"
    done
}

install_common

if [ "$PROFILE" = server ]; then
    source_shell "$HOME/.bashrc" "$DOTFILES_DIR/shell/bashrc"
    link_file "$DOTFILES_DIR/config/inputrc" "$HOME/.inputrc"
    link_file "$DOTFILES_DIR/config/vim/vimrc" "$HOME/.vimrc"
else
    source_shell "$HOME/.zshenv" "$DOTFILES_DIR/shell/zsh/zshenv"
    source_shell "$HOME/.zshrc" "$DOTFILES_DIR/shell/zsh/zshrc"
    link_file "$DOTFILES_DIR/config/nvim/init.lua" "$CONFIG_HOME/nvim/init.lua"
fi

if command -v bat >/dev/null 2>&1; then
    if ! bat cache --build >/dev/null 2>&1; then
        printf 'warn  bat cache could not be rebuilt\n' >&2
    fi
fi

printf '\nInstalled %s profile.\n' "$PROFILE"
