# shellcheck shell=bash disable=SC1090,SC1091,SC2016,SC2034,SC2128,SC2206,SC2296,SC2298

# Powerlevel10k instant prompt must stay near the top. Anything that may ask for
# input, such as a keychain unlock, must run before this block.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

DOTFILES_DIR="${${(%):-%N}:A:h:h}"

setopt AUTO_CD APPEND_HISTORY COMPLETE_IN_WORD HIST_EXPIRE_DUPS_FIRST
setopt HIST_FCNTL_LOCK HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS HIST_SAVE_NO_DUPS HIST_VERIFY
setopt INC_APPEND_HISTORY_TIME NO_BEEP NO_CASE_GLOB NO_CLOBBER
setopt PROMPT_SUBST SHARE_HISTORY

. "$DOTFILES_DIR/shell/common/env.sh"
. "$DOTFILES_DIR/shell/common/aliases.sh"
. "$DOTFILES_DIR/shell/common/functions.sh"

# Completion paths must be finalized before compinit runs.
if [[ -n ${HOMEBREW_PREFIX-} ]]; then
    for completion_dir in \
        "$HOMEBREW_PREFIX/share/zsh-completions" \
        "$HOMEBREW_PREFIX/share/zsh/site-functions"; do
        [[ -d $completion_dir ]] && fpath=("$completion_dir" $fpath)
    done
fi
for completion_dir in "$HOME/.local/share/zsh/site-functions" "$HOME/.zfunc"; do
    [[ -d $completion_dir ]] && fpath=("$completion_dir" $fpath)
done
typeset -U fpath
unset completion_dir

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/completion"

ZSH_CACHE_DIR="$XDG_CACHE_HOME/zsh"
[[ -d $ZSH_CACHE_DIR/completion ]] || mkdir -p "$ZSH_CACHE_DIR/completion"
ZSH_COMPDUMP="$ZSH_CACHE_DIR/zcompdump-$ZSH_VERSION"

autoload -Uz compinit
compinit -d "$ZSH_COMPDUMP"
if [[ -s $ZSH_COMPDUMP && ( ! -s $ZSH_COMPDUMP.zwc || $ZSH_COMPDUMP -nt $ZSH_COMPDUMP.zwc ) ]]; then
    zcompile -R -- "$ZSH_COMPDUMP.zwc" "$ZSH_COMPDUMP" 2>/dev/null
fi

# Optional tools load from cached initialization scripts where possible.
. "$DOTFILES_DIR/shell/common/tools.sh"

bindkey -e
bindkey '^[[1;3D' backward-word
bindkey '^[[1;3C' forward-word
bindkey '^[[1;9D' beginning-of-line
bindkey '^[[1;9C' end-of-line
bindkey '^[[3;3~' backward-kill-word
bindkey '^[[3;9~' kill-word
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
WORDCHARS=${WORDCHARS//\/}

HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=500000

# Local settings load before plugins so they can configure plugin behavior.
dotfiles_local="$XDG_CONFIG_HOME/dotfiles/local.sh"
[[ -r $dotfiles_local ]] && source "$dotfiles_local"
unset dotfiles_local

_dotfiles_first_readable() {
    local candidate
    for candidate; do
        if [[ -r $candidate ]]; then
            REPLY=$candidate
            return 0
        fi
    done
    return 1
}

# Disabling automatic rebinding avoids work on every prompt. All custom widgets
# have already been defined, so a single bind during plugin load is sufficient.
typeset -g ZSH_AUTOSUGGEST_MANUAL_REBIND=1
if _dotfiles_first_readable \
    "$XDG_DATA_HOME/zsh/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "$XDG_DATA_HOME/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "${HOMEBREW_PREFIX-}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh; then
    source "$REPLY"
fi

# Powerlevel10k performs Git status asynchronously and supplies instant prompt.
p10k_loaded=0
if _dotfiles_first_readable \
    "$XDG_DATA_HOME/zsh/powerlevel10k/powerlevel10k.zsh-theme" \
    "$XDG_DATA_HOME/powerlevel10k/powerlevel10k.zsh-theme" \
    "${HOMEBREW_PREFIX-}/opt/powerlevel10k/share/powerlevel10k/powerlevel10k.zsh-theme" \
    /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme; then
    source "$REPLY"
    p10k_loaded=1
    if [[ -r $HOME/.p10k.zsh ]]; then
        source "$HOME/.p10k.zsh"
    else
        source "$DOTFILES_DIR/shell/p10k.zsh"
    fi
fi

if (( ! p10k_loaded )); then
    PROMPT='${TRS_PS1_LABEL:+$TRS_PS1_LABEL }%F{blue}%${TRS_PS1_NUM_DIRS:-1}d%f %(?..%F{yellow})${TRS_PS1_ICON:-%(!.#.$)}%f '
fi
unset p10k_loaded

unfunction _dotfiles_first_readable
unset REPLY
